{
  "name": "petrapms",
  "version": "1.0.0",
  "private": true,
  "description": "PetraPMS — hotel property management system for Bangladesh",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:win": "node scripts/build.mjs --release && node scripts/dist-win.mjs",
    "build:portable": "node scripts/build.mjs && pnpm --filter @petra/desktop dist:portable",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "restart-check": "node scripts/restart-check.mjs",
    "crash-test": "node scripts/crash-test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @petra/db generate",
    "db:migrate:new": "pnpm --filter @petra/db migrate:new",
    "db:seed": "node scripts/seed.mjs",
    "keygen": "pnpm --filter @petra/license-keygen start",
    "license": "pnpm --filter @petra/license-keygen start",
    "release:check": "node scripts/release-guard.mjs",
    "verify-installer": "node scripts/verify-installer.mjs",
    "stage-check": "node scripts/stage-check.mjs",
    "build:win:test": "node scripts/build.mjs && node scripts/dist-win.mjs --test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1"
    }
  }
}
